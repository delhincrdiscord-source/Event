# ====================================================
# Dashboard App — Environment Variables
# ====================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ====================================================

# ── Database ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/gameverse?schema=public"

# ── Better Auth ───────────────────────────────────
BETTER_AUTH_SECRET="generate-a-64-character-random-string-here"
BETTER_AUTH_URL="https://dashboard.delhincr.fun"

# ── Discord OAuth ─────────────────────────────────
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_BOT_TOKEN=""

# ── Upstash Redis (Cache + Rate Limiting + Pub/Sub) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Backblaze B2 (Storage) ────────────────────────
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET_NAME=""
B2_REGION="us-west-004"
B2_PUBLIC_URL=""

# ── Encryption ────────────────────────────────────
TOKEN_ENCRYPTION_KEY="generate-a-32-byte-hex-key-here"

# ── Admin Bootstrap ───────────────────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Health Endpoint Auth ──────────────────────────
HEALTH_ENDPOINT_TOKEN="generate-a-random-string-here"

# ── App URLs ──────────────────────────────────────
NEXT_PUBLIC_LANDING_URL="https://gameverse.delhincr.fun"
NEXT_PUBLIC_DASHBOARD_URL="https://dashboard.delhincr.fun"
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/delhi"
