---
---
<section id="discord" class="py-24 bg-[#09090b] border-b border-white/10 relative overflow-hidden">
  <!-- Glowing Background Blur -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-[#5865F2]/25 blur-[140px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="glass-card rounded-3xl border border-[#5865F2]/40 p-8 lg:p-14 bg-gradient-to-r from-[#0c0e1a] via-[#09090b] to-[#120f24] shadow-2xl relative overflow-hidden text-center max-w-4xl mx-auto space-y-6">
      
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#5865F2]/10 border border-[#5865F2]/40 text-xs font-mono-code text-[#5865F2] font-semibold">
        <span class="w-2.5 h-2.5 rounded-full bg-[#5865F2] animate-ping"></span>
        OFFICIAL DISCORD COMMUNITY
      </div>

      <h2 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight heading-section">
        Join the Delhi NCR Community. <br />
        <span class="text-[#5865F2]">discord.gg/delhi</span>
      </h2>

      <p class="text-gray-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        The online hub for gamers, students, and creators everywhere. Hop into voice channels, hang out in chat, and take part in festival events 100% online all month long.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="https://discord.gg/delhi" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-full bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-base shadow-xl shadow-[#5865F2]/30 hover:scale-105 transition-all duration-300 flex items-center justify-center gap-3"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 127.14 96.36">
            <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,0,106,106,0,0,0,22.8,8.07,108.38,108.38,0,0,0,2.15,73A105.81,105.81,0,0,0,34.2,89.17A77.7,77.7,0,0,0,40.75,78.5a69.83,69.83,0,0,1-11-5.26c.92-.67,1.83-1.37,2.71-2.09a74,74,0,0,0,62.24,0c.89.72,1.79,1.42,2.71,2.09a70,70,0,0,1-11,5.27,77.84,77.84,0,0,0,6.55,10.66,105.62,105.62,0,0,0,32.06-16.17A108.29,108.29,0,0,0,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5.07-12.72,11.45-12.72c6.43,0,11.58,5.77,11.45,12.72C53.9,60,48.78,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5.07-12.72,11.44-12.72C91.12,40.28,96.28,46,96.14,53,96.14,60,91.06,65.69,84.69,65.69Z"/>
          </svg>
          <span>Join Server Now</span>
        </a>
      </div>

    </div>
  </div>
</section>
