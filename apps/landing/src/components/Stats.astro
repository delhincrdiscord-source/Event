---
---
<section class="py-20 bg-[#07070a] relative border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Eyebrow & Title -->
    <div class="text-center mb-14 space-y-3">
      <span class="text-xs font-mono-code text-[#7928ca] uppercase tracking-widest bg-[#7928ca]/10 border border-[#7928ca]/30 px-3 py-1 rounded-full">
        FESTIVAL METRICS
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight heading-section">
        Delhi NCR Gaming by the Numbers.
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-base">
        A month of unprecedented scale, bringing together casual gamers, semi-pro squads, and top content creators.
      </p>
    </div>

    <!-- 5 Stats Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      
      <!-- Stat 1 -->
      <div class="aurora-card rounded-2xl p-6 border border-white/10 relative overflow-hidden group hover:border-[#7928ca]/50">
        <div class="w-10 h-10 rounded-xl bg-[#7928ca]/20 text-[#7928ca] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <span class="text-xs font-mono-code text-gray-400 uppercase tracking-wider block mb-1">Total Players</span>
        <span class="text-3xl font-extrabold text-white heading-section">15,000+</span>
        <p class="text-xs text-gray-400 mt-2">Registered competitors across 12 esports tournaments.</p>
      </div>

      <!-- Stat 2 -->
      <div class="aurora-card rounded-2xl p-6 border border-white/10 relative overflow-hidden group hover:border-[#007cf0]/50">
        <div class="w-10 h-10 rounded-xl bg-[#007cf0]/20 text-[#007cf0] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a2 2 0 01-2 2 2 2 0 01-2-2V4zm-6 8a2 2 0 114 0v1a2 2 0 01-2 2 2 2 0 01-2-2v-1zm12 0a2 2 0 114 0v1a2 2 0 01-2 2 2 2 0 01-2-2v-1z"/></svg>
        </div>
        <span class="text-xs font-mono-code text-gray-400 uppercase tracking-wider block mb-1">Esports Titles</span>
        <span class="text-3xl font-extrabold text-white heading-section">12 Arenas</span>
        <p class="text-xs text-gray-400 mt-2">Valorant, CS2, Tekken 8, EA FC 26, BGMI & more.</p>
      </div>

      <!-- Stat 3 -->
      <div class="aurora-card rounded-2xl p-6 border border-white/10 relative overflow-hidden group hover:border-[#50e3c2]/50">
        <div class="w-10 h-10 rounded-xl bg-[#50e3c2]/20 text-[#50e3c2] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <span class="text-xs font-mono-code text-gray-400 uppercase tracking-wider block mb-1">Prize Pool</span>
        <span class="text-3xl font-extrabold text-[#50e3c2] heading-section">₹25 Lakhs</span>
        <p class="text-xs text-gray-400 mt-2">Cash distribution + hardware rewards & trophies.</p>
      </div>

      <!-- Stat 4 -->
      <div class="aurora-card rounded-2xl p-6 border border-white/10 relative overflow-hidden group hover:border-[#ff0080]/50">
        <div class="w-10 h-10 rounded-xl bg-[#ff0080]/20 text-[#ff0080] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <span class="text-xs font-mono-code text-gray-400 uppercase tracking-wider block mb-1">Festival Events</span>
        <span class="text-3xl font-extrabold text-white heading-section">30+ Days</span>
        <p class="text-xs text-gray-400 mt-2">Daily scrims, qualifiers, cosplay show & LAN finals.</p>
      </div>

      <!-- Stat 5 -->
      <div class="aurora-card rounded-2xl p-6 border border-white/10 relative overflow-hidden group hover:border-[#5865F2]/50 sm:col-span-2 lg:col-span-1">
        <div class="w-10 h-10 rounded-xl bg-[#5865F2]/20 text-[#5865F2] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 127.14 96.36">
            <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,0,106,106,0,0,0,22.8,8.07,108.38,108.38,0,0,0,2.15,73A105.81,105.81,0,0,0,34.2,89.17A77.7,77.7,0,0,0,40.75,78.5a69.83,69.83,0,0,1-11-5.26c.92-.67,1.83-1.37,2.71-2.09a74,74,0,0,0,62.24,0c.89.72,1.79,1.42,2.71,2.09a70,70,0,0,1-11,5.27,77.84,77.84,0,0,0,6.55,10.66,105.62,105.62,0,0,0,32.06-16.17A108.29,108.29,0,0,0,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5.07-12.72,11.45-12.72c6.43,0,11.58,5.77,11.45,12.72C53.9,60,48.78,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5.07-12.72,11.44-12.72C91.12,40.28,96.28,46,96.14,53,96.14,60,91.06,65.69,84.69,65.69Z"/>
          </svg>
        </div>
        <span class="text-xs font-mono-code text-gray-400 uppercase tracking-wider block mb-1">Discord Members</span>
        <span class="text-3xl font-extrabold text-[#5865F2] heading-section">54,000+</span>
        <p class="text-xs text-gray-400 mt-2">Active community members in discord.gg/delhi.</p>
      </div>

    </div>
  </div>
</section>
