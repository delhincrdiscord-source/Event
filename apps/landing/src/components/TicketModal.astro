---
---
<div id="ticket-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
  <div class="glass-card rounded-3xl border border-white/20 p-6 sm:p-8 max-w-lg w-full relative shadow-2xl bg-[#0e0f17] text-white">
    
    <!-- Close Button -->
    <button 
      onclick="document.getElementById('ticket-modal').classList.add('hidden')"
      class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white/10 text-gray-400 hover:text-white flex items-center justify-center hover:bg-white/20 transition-colors cursor-pointer"
      aria-label="Close Registration Modal"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Modal Form Body -->
    <div id="modal-form-step">
      <div class="space-y-2 mb-6">
        <span class="text-[10px] font-mono-code text-[#5865F2] uppercase tracking-widest bg-[#5865F2]/10 border border-[#5865F2]/30 px-2.5 py-0.5 rounded-full">
          COMMUNITY FESTIVAL PASS
        </span>
        <h3 class="text-2xl font-bold text-white heading-section">Register for Gameverse 2026.</h3>
        <p class="text-xs text-gray-400">100% Free registration. Get your digital community pass for Delhi NCR Gameverse 2026.</p>
      </div>

      <!-- Step 1: Discord OAuth -->
      <div id="discord-step">
        <div class="space-y-4">
          <div class="bg-[#5865F2]/10 border border-[#5865F2]/30 rounded-xl p-4 text-center">
            <p class="text-xs text-gray-300 mb-3">
              Connect your Discord account to verify membership and create your festival pass.
            </p>
            <button 
              id="discord-oauth-btn"
              onclick="startDiscordOAuth()"
              class="w-full py-3.5 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer shadow-lg flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 127.14 96.36">
                <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,0,106,106,0,0,0,22.8,8.07,108.38,108.38,0,0,0,2.15,73A105.81,105.81,0,0,0,34.2,89.17A77.7,77.7,0,0,0,40.75,78.5a69.83,69.83,0,0,1-11-5.26c.92-.67,1.83-1.37,2.71-2.09a74,74,0,0,0,62.24,0c.89.72,1.79,1.42,2.71,2.09a70,70,0,0,1-11,5.27,77.84,77.84,0,0,0,6.55,10.66,105.62,105.62,0,0,0,32.06-16.17A108.29,108.29,0,0,0,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5.07-12.72,11.45-12.72c6.43,0,11.58,5.77,11.45,12.72C53.9,60,48.78,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5.07-12.72,11.44-12.72C91.12,40.28,96.28,46,96.14,53,96.14,60,91.06,65.69,84.69,65.69Z" />
              </svg>
              Sign in with Discord
            </button>
          </div>

          <div id="discord-status" class="hidden text-center text-xs text-gray-400">
            <div class="flex items-center justify-center gap-2">
              <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>Connecting to Discord...</span>
            </div>
          </div>

          <div id="form-error" class="hidden text-red-400 text-xs text-center"></div>
        </div>
      </div>

      <!-- Step 2: Registration Details (shown after Discord OAuth) -->
      <div id="registration-step" class="hidden">
        <form id="registration-form" class="space-y-4 text-xs font-mono-code">
          <div id="discord-user-info" class="bg-[#5865F2]/10 border border-[#5865F2]/30 rounded-xl p-3 flex items-center gap-3">
            <img id="discord-avatar" src="" alt="" class="w-10 h-10 rounded-full" />
            <div>
              <p id="discord-username" class="font-bold text-white"></p>
              <p id="discord-id" class="text-gray-400 text-[10px]"></p>
            </div>
            <span class="ml-auto text-[#50e3c2] text-[10px] font-bold">VERIFIED</span>
          </div>

          <div>
            <label class="block text-gray-300 mb-1">Your Name</label>
            <input required type="text" name="name" placeholder="e.g. Aarav Sharma" class="w-full px-3.5 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white focus:outline-none focus:border-[#5865F2] transition-colors" />
          </div>

          <div>
            <label class="block text-gray-300 mb-1">Email Address</label>
            <input required type="email" name="email" placeholder="member@delhin.gg" class="w-full px-3.5 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white focus:outline-none focus:border-[#5865F2] transition-colors" />
          </div>

          <div>
            <label class="block text-gray-300 mb-1">Primary Interest</label>
            <select name="interest" class="w-full px-3.5 py-2.5 rounded-xl bg-[#141522] border border-white/10 text-white focus:outline-none focus:border-[#5865F2] transition-colors">
              <option>Casual Gaming Nights (Valorant, BGMI, Among Us)</option>
              <option>Minecraft SMP Server</option>
              <option>Movie & Anime Screenings</option>
              <option>Giveaways & Discord Nitro Quests</option>
              <option>Music & Open Mic Lounges</option>
              <option>Chess & Strategy Board Games</option>
            </select>
          </div>

          <div id="registration-error" class="hidden text-red-400 text-xs"></div>

          <button id="submit-btn" type="submit" class="w-full py-3.5 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer shadow-lg mt-2">
            Claim Digital Festival Badge
          </button>
        </form>
      </div>
    </div>

    <!-- Success Confirmation Step -->
    <div id="modal-success-step" class="hidden text-center space-y-4 py-4 font-mono-code">
      <div class="w-14 h-14 rounded-full bg-[#5865F2]/20 text-[#5865F2] flex items-center justify-center mx-auto border border-[#5865F2]/40">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>

      <h3 class="text-xl font-bold text-white">Pass Registered!</h3>
      <p class="text-xs text-gray-300">Welcome to Delhi NCR Gameverse 2026! Join the server to get your festival role badge.</p>

      <div class="bg-black/50 border border-white/10 rounded-2xl p-4 text-left space-y-2 text-xs">
        <div class="flex justify-between items-center text-gray-400 border-b border-white/10 pb-2">
          <span id="success-pass-number">Badge ID: #GV2026-COMMUNITY</span>
          <span class="text-[#50e3c2]">VERIFIED</span>
        </div>
        <div class="font-bold text-white">Delhi NCR Gameverse 2026 Pass</div>
        <div class="text-gray-400">Valid: October 1 - 31, 2026 • discord.gg/delhi</div>
      </div>

      <button 
        onclick="document.getElementById('ticket-modal').classList.add('hidden'); resetModal();"
        class="w-full py-3 rounded-xl bg-white/10 text-white font-semibold text-xs hover:bg-white/20 transition-colors"
      >
        Done
      </button>
    </div>

  </div>
</div>

<script is:inline>
  let discordUserData = null;

  function showSuccessStep(passNumber) {
    document.getElementById('modal-form-step').classList.add('hidden');
    document.getElementById('modal-success-step').classList.remove('hidden');
    document.getElementById('success-pass-number').textContent = `Badge ID: #${passNumber}`;
  }

  function resetModal() {
    document.getElementById('modal-form-step').classList.remove('hidden');
    document.getElementById('modal-success-step').classList.add('hidden');
    document.getElementById('discord-step').classList.remove('hidden');
    document.getElementById('registration-step').classList.add('hidden');
    document.getElementById('form-error')?.classList.add('hidden');
    document.getElementById('registration-error')?.classList.add('hidden');
    document.getElementById('discord-status')?.classList.add('hidden');
    document.getElementById('discord-oauth-btn')?.classList.remove('hidden');
    discordUserData = null;
  }

  function startDiscordOAuth() {
    const btn = document.getElementById('discord-oauth-btn');
    const status = document.getElementById('discord-status');
    const errorEl = document.getElementById('form-error');
    
    btn?.classList.add('hidden');
    status?.classList.remove('hidden');
    errorEl?.classList.add('hidden');

    const dashboardUrl = 'https://dashboard.delhincr.fun';

    const oauthUrl = `${dashboardUrl}/api/auth/login/discord`;
    
    window.location.href = oauthUrl;
  }

  function handleDiscordCallback() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('discord') === 'connected') {
      const dashboardUrl = 'https://dashboard.delhincr.fun';

      fetch(`${dashboardUrl}/api/auth/get-session`, {
        credentials: 'include'
      })
        .then(res => res.json())
        .then(data => {
          if (data && data.user) {
            discordUserData = data.user;
            showRegistrationStep(data.user);
          } else {
            showError('Failed to get Discord user data. Please try again.');
          }
        })
        .catch(() => {
          showError('Failed to connect to server. Please try again.');
        });

      window.history.replaceState({}, '', window.location.pathname);
    }
  }

  function showRegistrationStep(user) {
    document.getElementById('discord-step')?.classList.add('hidden');
    document.getElementById('registration-step')?.classList.remove('hidden');
    
    document.getElementById('discord-avatar').src = user.image || `https://cdn.discordapp.com/embed/avatars/${parseInt(user.id) % 5}.png`;
    document.getElementById('discord-username').textContent = user.name || user.username || 'Discord User';
    document.getElementById('discord-id').textContent = `ID: ${user.id}`;
    
    const nameInput = document.querySelector('#registration-form input[name="name"]');
    if (nameInput && user.name) {
      nameInput.value = user.name;
    }
    
    const emailInput = document.querySelector('#registration-form input[name="email"]');
    if (emailInput && user.email) {
      emailInput.value = user.email;
    }
  }

  function showError(message) {
    const errorEl = document.getElementById('form-error');
    const status = document.getElementById('discord-status');
    const btn = document.getElementById('discord-oauth-btn');
    
    status?.classList.add('hidden');
    btn?.classList.remove('hidden');
    
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  document.getElementById('registration-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    const errorEl = document.getElementById('registration-error');
    const form = e.target;
    
    btn.disabled = true;
    btn.textContent = 'REGISTERING...';
    errorEl?.classList.add('hidden');

    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      interest: formData.get('interest'),
      discordUserId: discordUserData?.id,
      discordUsername: discordUserData?.username || discordUserData?.name,
    };

    try {
      const dashboardUrl = 'https://dashboard.delhincr.fun';
      const res = await fetch(dashboardUrl + '/api/v1/register/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(data),
      });
      const result = await res.json();

      if (result.success) {
        showSuccessStep(result.data.passNumber);
      } else {
        errorEl.textContent = result.error || 'Registration failed. Please try again.';
        errorEl.classList.remove('hidden');
      }
    } catch (err) {
      errorEl.textContent = 'Network error. Please try again later.';
      errorEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'CLAIM DIGITAL FESTIVAL BADGE';
    }
  });

  document.addEventListener('DOMContentLoaded', handleDiscordCallback);
</script>
