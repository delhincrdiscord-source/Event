---
const prizeBreakdown = [
  { game: "Valorant Masters", total: "₹6,50,000", first: "₹3,50,000", second: "₹1,80,000", third: "₹80,000", MVP: "₹40,000" },
  { game: "Counter-Strike 2", total: "₹5,00,000", first: "₹2,50,000", second: "₹1,40,000", third: "₹70,000", MVP: "₹40,000" },
  { game: "BGMI Battlezone", total: "₹4,50,000", first: "₹2,20,000", second: "₹1,20,000", third: "₹70,000", MVP: "₹40,000" },
  { game: "Tekken 8 Arena", total: "₹3,00,000", first: "₹1,50,000", second: "₹80,000", third: "₹40,000", MVP: "₹30,000" },
  { game: "EA FC 26 Cup", total: "₹2,00,000", first: "₹1,00,000", second: "₹55,000", third: "₹30,000", MVP: "₹15,000" },
  { game: "Cosplay & Sim Racing", total: "₹4,00,000", first: "₹2,00,000", second: "₹1,10,000", third: "₹60,000", MVP: "₹30,000" }
];
---

<section id="prize-pool" class="py-24 bg-[#07070a] border-b border-white/10 relative overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/3 right-0 w-96 h-96 bg-[#50e3c2]/10 blur-[130px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Title -->
    <div class="text-center mb-16 space-y-3">
      <span class="text-xs font-mono-code text-[#50e3c2] uppercase tracking-widest bg-[#50e3c2]/10 border border-[#50e3c2]/30 px-3 py-1 rounded-full">
        REWARDS & PURSE
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight heading-section">
        ₹25,00,000 Prize Pool.
      </h2>
      <p class="text-gray-400 max-w-xl mx-auto text-base">
        Direct wire transfers, custom championship rings, ASUS ROG hardware rewards, and MVP bonuses.
      </p>
    </div>

    <!-- Main Highlight Cards: 1st, 2nd, 3rd Trophy Podiums -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      
      <!-- 2nd Place Card -->
      <div class="aurora-card rounded-2xl p-6 border border-white/10 text-center relative group hover:border-[#007cf0]/50 order-2 md:order-1">
        <div class="w-14 h-14 rounded-2xl bg-[#007cf0]/20 text-[#007cf0] font-mono-code text-2xl font-bold flex items-center justify-center mx-auto mb-4 border border-[#007cf0]/30">
          2nd
        </div>
        <h3 class="text-lg font-bold text-white mb-1">Runner Up Pool</h3>
        <span class="text-2xl font-extrabold text-[#00dfd8] block mb-2 font-mono-code">₹6,85,000 Total</span>
        <p class="text-xs text-gray-400">Awarded across all 12 esports title brackets + silver medal shields.</p>
      </div>

      <!-- 1st Place Champion Card (Featured Gold Glow) -->
      <div class="aurora-card rounded-2xl p-8 border border-amber-500/40 text-center relative group hover:border-amber-400 transition-all shadow-2xl shadow-amber-500/10 order-1 md:order-2 scale-105 bg-gradient-to-b from-[#1a1710] to-[#07070a]">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gradient-to-r from-amber-400 to-yellow-500 text-black text-[10px] font-mono-code font-bold px-3 py-0.5 rounded-full uppercase tracking-wider">
          CHAMPIONSHIP CROWN
        </div>
        <div class="w-16 h-16 rounded-2xl bg-amber-500/20 text-amber-400 font-mono-code text-3xl font-extrabold flex items-center justify-center mx-auto mb-4 border border-amber-500/40">
          1st
        </div>
        <h3 class="text-xl font-bold text-white mb-1">Grand Champions Pool</h3>
        <span class="text-4xl font-extrabold text-amber-400 block mb-2 font-mono-code">₹12,70,000</span>
        <p class="text-xs text-gray-300">Custom Gameverse 2026 Gold Trophy + ZOWIE 240Hz monitors for every team member.</p>
      </div>

      <!-- 3rd Place Card -->
      <div class="aurora-card rounded-2xl p-6 border border-white/10 text-center relative group hover:border-[#7928ca]/50 order-3">
        <div class="w-14 h-14 rounded-2xl bg-[#7928ca]/20 text-[#7928ca] font-mono-code text-2xl font-bold flex items-center justify-center mx-auto mb-4 border border-[#7928ca]/30">
          3rd
        </div>
        <h3 class="text-lg font-bold text-white mb-1">Bronze Podium</h3>
        <span class="text-2xl font-extrabold text-purple-400 block mb-2 font-mono-code">₹3,40,000 Total</span>
        <p class="text-xs text-gray-400">Bronze medals + HyperX Cloud III Wireless Headsets for third place squads.</p>
      </div>

    </div>

    <!-- Detailed Table Breakdown -->
    <div class="aurora-card rounded-2xl border border-white/10 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left font-mono-code text-xs">
          <thead class="bg-white/[0.04] text-gray-300 uppercase tracking-wider border-b border-white/10">
            <tr>
              <th class="py-4 px-6">Esports Title</th>
              <th class="py-4 px-6">Total Purse</th>
              <th class="py-4 px-6 text-amber-400">1st Place</th>
              <th class="py-4 px-6 text-[#00dfd8]">2nd Place</th>
              <th class="py-4 px-6 text-purple-400">3rd Place</th>
              <th class="py-4 px-6 text-[#50e3c2]">MVP Award</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-gray-300">
            {prizeBreakdown.map((row) => (
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-4 px-6 font-bold text-white">{row.game}</td>
                <td class="py-4 px-6 font-bold text-white">{row.total}</td>
                <td class="py-4 px-6 text-amber-400 font-semibold">{row.first}</td>
                <td class="py-4 px-6 text-[#00dfd8]">{row.second}</td>
                <td class="py-4 px-6 text-purple-400">{row.third}</td>
                <td class="py-4 px-6 text-[#50e3c2]">{row.MVP}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>
