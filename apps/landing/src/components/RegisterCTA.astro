---
---
<section class="py-20 bg-[#09090b] border-b border-white/10 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="glass-card rounded-3xl p-10 lg:p-12 border border-white/10 relative overflow-hidden space-y-6">
      
      <span class="text-xs font-mono-code text-[#50e3c2] uppercase tracking-widest bg-[#50e3c2]/10 border border-[#50e3c2]/30 px-3 py-1 rounded-full">
        FREE COMMUNITY PASS
      </span>

      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight heading-section">
        Ready for October 2026?
      </h2>

      <p class="text-gray-300 max-w-xl mx-auto text-base">
        Claim your free Delhi NCR Gameverse 2026 digital badge to unlock special Discord roles and event notifications.
      </p>

      <div>
        <button 
          onclick="document.getElementById('ticket-modal').classList.remove('hidden')"
          class="px-8 py-4 rounded-full bg-white text-black font-semibold text-base hover:bg-gray-200 transition-all duration-300 shadow-xl shadow-white/10 active:scale-95 cursor-pointer"
        >
          Register For Free Pass
        </button>
      </div>

    </div>
  </div>
</section>
