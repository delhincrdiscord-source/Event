---
---
<section id="about" class="py-24 bg-[#09090b] border-b border-white/10 relative overflow-hidden">
  <!-- Glowing Ambient Blob -->
  <div class="absolute top-1/2 left-0 w-96 h-96 bg-[#5865F2]/15 blur-[140px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Story Text -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 text-xs font-mono-code text-[#5865F2] uppercase tracking-widest bg-[#5865F2]/10 border border-[#5865F2]/30 px-3 py-1 rounded-full">
          COMMUNITY FIRST
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight heading-section">
          What is Delhi NCR Gameverse? <br />
          <span class="text-gradient-blurple">A Festival Made by Friends.</span>
        </h2>
        <p class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal">
          Delhi NCR Gameverse 2026 is an annual month-long community festival hosted by the official 
          <strong>Delhi NCR Discord Community</strong> (<a href="https://discord.gg/delhi" target="_blank" class="text-[#5865F2] hover:underline">discord.gg/delhi</a>).
        </p>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
          We created Gameverse to bring together gamers, artists, students, and tech enthusiasts from anywhere in the world. You do NOT need to live in Delhi to join — all events, custom gaming nights, giveaways, and voice hangouts are hosted 100% online on our Discord server (<a href="https://discord.gg/delhi" target="_blank" class="text-[#5865F2] hover:underline">discord.gg/delhi</a>). Everyone, everywhere is welcome!
        </p>

        <!-- Community Pillars Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
          <div class="glass-card p-4 rounded-xl border border-white/10 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#5865F2]/20 text-[#5865F2] flex items-center justify-center shrink-0 font-bold">1</div>
            <div>
              <h3 class="text-white font-semibold text-sm">Everyone is Welcome</h3>
              <p class="text-xs text-gray-400">Casual players, hardcore gamers, artists, & spectators alike.</p>
            </div>
          </div>

          <div class="glass-card p-4 rounded-xl border border-white/10 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#50e3c2]/20 text-[#50e3c2] flex items-center justify-center shrink-0 font-bold">2</div>
            <div>
              <h3 class="text-white font-semibold text-sm">Zero Entry Fees</h3>
              <p class="text-xs text-gray-400">100% free community events, voice channels & giveaways.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Discord Server Preview Card -->
      <div class="lg:col-span-5">
        <div class="glass-card rounded-3xl border border-white/15 p-6 shadow-2xl relative space-y-4">
          
          <!-- Discord Server Header Mockup -->
          <div class="flex items-center gap-3 border-b border-white/10 pb-4">
            <div class="w-12 h-12 rounded-2xl bg-[#5865F2] flex items-center justify-center font-bold text-white text-xl shadow-md">
              NCR
            </div>
            <div>
              <h3 class="text-base font-bold text-white flex items-center gap-1.5">
                <span>Delhi NCR</span>
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              </h3>
              <span class="text-xs font-mono-code text-gray-400">discord.gg/delhi</span>
            </div>
          </div>

          <!-- Feature Bullets -->
          <div class="space-y-3 text-xs font-mono-code">
            <div class="flex items-center gap-2 text-gray-300">
              <span class="text-[#5865F2]">✦</span>
              <span>Daily Voice Lounges & Scrim Channels</span>
            </div>
            <div class="flex items-center gap-2 text-gray-300">
              <span class="text-[#50e3c2]">✦</span>
              <span>Weekend Movie & Anime Screenings</span>
            </div>
            <div class="flex items-center gap-2 text-gray-300">
              <span class="text-[#7928ca]">✦</span>
              <span>Community Minecraft & Among Us Nights</span>
            </div>
            <div class="flex items-center gap-2 text-gray-300">
              <span class="text-amber-400">✦</span>
              <span>Nitro Drops & Community Badges</span>
            </div>
          </div>

          <!-- Action -->
          <div class="pt-4 border-t border-white/10">
            <a 
              href="https://discord.gg/delhi" 
              target="_blank" 
              class="w-full py-3 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-xs flex items-center justify-center gap-2 transition-colors"
            >
              <span>Join Server (discord.gg/delhi)</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
