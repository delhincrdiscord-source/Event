---
const testimonials = [
  {
    quote: "Playing the Valorant Finals on 240Hz ZOWIE monitors at Gurugram CyberHub was easily the peak highlight of my gaming journey. The organization and anti-cheat checks were as smooth as a VCT event.",
    author: "Rohan 'Scythe' Sharma",
    role: "IGL, Team NCR Cyphers (Gurugram)",
    avatar: "RS",
    title: "Valorant Champion 2025"
  },
  {
    quote: "The Delhi NCR Discord server literally built my gaming squad. Being able to compete in a month-long festival with zero entry fee and ₹25 Lakhs up for grabs is unheard of in North India.",
    author: "Aanya 'Valkyrie' Verma",
    role: "Cosplay Master & Streamer (New Delhi)",
    avatar: "AV",
    title: "Best Cosplay Craftsmanship"
  },
  {
    quote: "From online Swiss qualifiers to standing on the mainstage with 2,000+ hype spectators chanting our team name — Gameverse is the gold standard for Indian community esports.",
    author: "Karan 'Apex' Malhotra",
    role: "CS2 Entry Fragger (Noida)",
    avatar: "KM",
    title: "CS2 MVP Finalist"
  }
];
---

<section class="py-24 bg-[#07070a] border-b border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="text-center mb-16 space-y-3">
      <span class="text-xs font-mono-code text-[#7928ca] uppercase tracking-widest bg-[#7928ca]/10 border border-[#7928ca]/30 px-3 py-1 rounded-full">
        VOICES OF THE COMMUNITY
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight heading-section">
        Loved by NCR Competitors.
      </h2>
      <p class="text-gray-400 max-w-xl mx-auto text-base">
        Hear from past tournament champions, collegiate captains, and creators who experienced the rush.
      </p>
    </div>

    <!-- Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="aurora-card rounded-2xl p-8 border border-white/10 relative flex flex-col justify-between group hover:border-[#7928ca]/40 transition-all">
          <div>
            <!-- Rating Stars -->
            <div class="flex items-center gap-1 text-amber-400 mb-4">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>

            <p class="text-sm text-gray-300 leading-relaxed mb-6 italic">
              "{item.quote}"
            </p>
          </div>

          <div class="flex items-center gap-3 pt-4 border-t border-white/10">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#7928ca] to-[#007cf0] text-white font-mono-code font-bold flex items-center justify-center text-xs shrink-0">
              {item.avatar}
            </div>
            <div>
              <h3 class="text-xs font-bold text-white">{item.author}</h3>
              <p class="text-[11px] font-mono-code text-[#50e3c2]">{item.role}</p>
              <span class="text-[10px] text-gray-400 block">{item.title}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
