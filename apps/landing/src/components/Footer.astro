---
---
<footer class="bg-[#09090b] border-t border-white/10 pt-16 pb-12 font-sans relative z-10 text-gray-400 text-xs">
  
  <!-- JSON-LD Event & Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "Delhi NCR Gameverse 2026",
    "startDate": "2026-10-01T00:00:00+05:30",
    "endDate": "2026-10-31T23:59:59+05:30",
    "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "VirtualLocation",
      "url": "https://discord.gg/delhi"
    },
    "description": "A month of community events, gaming nights, giveaways, voice activities and unforgettable moments with the Delhi NCR Discord Community.",
    "organizer": {
      "@type": "Organization",
      "name": "Delhi NCR Discord Community",
      "url": "https://discord.gg/delhi"
    }
  })} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand Info Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="#" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-xl bg-[#5865F2]/20 border border-[#5865F2]/40 p-0.5 shadow-lg flex items-center justify-center overflow-hidden">
            <img src="/logo.gif" alt="Logo" class="w-full h-full object-cover rounded-[8px]" />
          </div>
          <span class="font-bold text-base tracking-tight text-white">
            DELHI NCR GAMEVERSE <span class="text-[10px] font-mono-code text-[#5865F2]">2026</span>
          </span>
        </a>

        <p class="text-gray-400 text-xs leading-relaxed max-w-sm">
          Hosted with heart by the official Delhi NCR Discord Community (<a href="https://discord.gg/delhi" target="_blank" class="text-[#5865F2] hover:underline">discord.gg/delhi</a>). 
          Connecting gamers, students, and creators across Delhi NCR all October long.
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="space-y-3 font-mono-code">
        <h4 class="text-white font-bold uppercase tracking-wider text-[11px]">Navigation</h4>
        <ul class="space-y-2">
          <li><a href="#about" class="hover:text-white transition-colors">About Festival</a></li>
          <li><a href="#highlights" class="hover:text-white transition-colors">Event Highlights</a></li>
          <li><a href="#schedule" class="hover:text-white transition-colors">4-Week Schedule</a></li>
          <li><a href="#process" class="hover:text-white transition-colors">How to Join</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: Community -->
      <div class="space-y-3 font-mono-code">
        <h4 class="text-white font-bold uppercase tracking-wider text-[11px]">Community</h4>
        <ul class="space-y-2">
          <li><a href="https://discord.gg/delhi" target="_blank" class="text-[#5865F2] hover:underline font-semibold">Join discord.gg/delhi</a></li>
          <li><a href="#discord" class="hover:text-white transition-colors">Voice Lounges</a></li>
          <li><a href="#highlights" class="hover:text-white transition-colors">Minecraft SMP World</a></li>
          <li><a href="#highlights" class="hover:text-white transition-colors">Movie Watchparties</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Strip -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono-code text-[11px] text-gray-500">
      <div>
        © 2026 Delhi NCR Gameverse. Hosted by the Delhi NCR Discord Community.
      </div>
      <div class="flex items-center gap-6">
        <a href="https://discord.gg/delhi" target="_blank" class="hover:text-gray-300">discord.gg/delhi</a>
        <a href="#" class="hover:text-gray-300">Community Guidelines</a>
      </div>
    </div>

  </div>
</footer>
