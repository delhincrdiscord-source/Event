---
const pillars = [
  {
    title: "100% Free Entry & Open Access",
    badge: "ZERO COST",
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    description: "No hidden registration fees or pass costs. Every gamer in Delhi NCR gets equal access to online qualifiers and spectator arenas.",
    color: "from-emerald-500/20 to-teal-500/20",
    textColor: "text-emerald-400"
  },
  {
    title: "Pro Scout & Esports Pathways",
    badge: "TALENT SCOUTING",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    description: "Top esports scouts and team managers analyze official tournament stats and VODs to scout high-ELO players for academy rosters.",
    color: "from-blue-500/20 to-cyan-500/20",
    textColor: "text-blue-400"
  },
  {
    title: "LAN Mainstage Experience",
    badge: "240HZ LAN",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    description: "Play your finals live at Gurugram CyberHub on ZOWIE XL2546K 240Hz monitors with dedicated noise-canceling headsets.",
    color: "from-purple-500/20 to-violet-500/20",
    textColor: "text-purple-400"
  },
  {
    title: "Community & Creator Lounges",
    badge: "54k DISCORD",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
    description: "Connect with fellow gamers, duo partners, streamers, and animators across Delhi, Noida, and Gurugram in person.",
    color: "from-pink-500/20 to-rose-500/20",
    textColor: "text-pink-400"
  }
];
---

<section class="py-24 bg-[#07070a] border-b border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center mb-16 space-y-3">
      <span class="text-xs font-mono-code text-[#7928ca] uppercase tracking-widest bg-[#7928ca]/10 border border-[#7928ca]/30 px-3 py-1 rounded-full">
        WHY ATTEND
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight heading-section">
        Why Join Delhi NCR Gameverse?
      </h2>
      <p class="text-gray-400 max-w-xl mx-auto text-base">
        Crafted specifically for gamers who demand high-tier competition, verified anti-cheat environments, and epic LAN memories.
      </p>
    </div>

    <!-- 4 Pillar Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {pillars.map((item) => (
        <div class="aurora-card rounded-2xl p-8 border border-white/10 relative group hover:border-white/20 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${item.color} ${item.textColor} flex items-center justify-center border border-white/10 group-hover:scale-110 transition-transform`}>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/></svg>
              </div>
              <span class={`text-[10px] font-mono-code font-bold px-2.5 py-0.5 rounded-full border bg-white/5 border-white/10 ${item.textColor}`}>
                {item.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-[#50e3c2] transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-gray-400 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
