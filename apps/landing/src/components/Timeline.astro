---
const weeks = [
  {
    week: "WEEK 1",
    dates: "OCT 1 - OCT 7, 2026",
    title: "Community Kickoff",
    status: "LAUNCH WEEK",
    statusColor: "bg-[#5865F2]/10 text-[#5865F2] border-[#5865F2]/30",
    description: "Opening ceremony in voice lounges, avatar showcases, team creation, and welcome giveaways.",
    events: [
      "Official Festival Voice Keynote & Q&A",
      "Minecraft SMP Server World Launch",
      "Skribbl.io & Among Us Icebreakers",
      "First Discord Nitro Giveaway Drop"
    ]
  },
  {
    week: "WEEK 2",
    dates: "OCT 8 - OCT 15, 2026",
    title: "Game Events & Customs",
    status: "GAMING NIGHTS",
    statusColor: "bg-purple-500/10 text-purple-400 border-purple-500/30",
    description: "Non-stop custom gaming lobbies across Valorant, BGMI, Chess, Fall Guys, and Sim Racing.",
    events: [
      "Valorant 5v5 Custom Party Lobbies",
      "BGMI Fun Rooms (Pan & Sniper Only)",
      "Delhi Blitz Chess Tournament",
      "Friday Anime & Movie Screening"
    ]
  },
  {
    week: "WEEK 3",
    dates: "OCT 16 - OCT 23, 2026",
    title: "Challenges & Contests",
    status: "CREATIVE & QUESTS",
    statusColor: "bg-cyan-500/10 text-cyan-400 border-cyan-500/30",
    description: "Creative art showcases, setup tours, clip of the week voting, and Special Guest Q&A hangouts.",
    events: [
      "Digital Art & Fanart Showcase Voting",
      "Gaming Setup Showcase & Review",
      "Special Guest Streamer Voice Session",
      "Open Mic Music & Jam Lounge"
    ]
  },
  {
    week: "WEEK 4",
    dates: "OCT 24 - OCT 31, 2026",
    title: "Closing Celebration",
    status: "FINALE WEEK",
    statusColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30 font-bold",
    description: "Grand community finale, awards gala for active members, hall-of-fame roles, and Halloween afterparty.",
    events: [
      "Festival Awards Gala & Role Distribution",
      "Community Highlights Video Stream",
      "Halloween Costume & Avatar Party",
      "Final Mega Nitro & Steam Key Drops"
    ]
  }
];
---

<section id="schedule" class="py-24 bg-[#09090b] border-b border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="text-center mb-16 space-y-3">
      <span class="text-xs font-mono-code text-[#7928ca] uppercase tracking-widest bg-[#7928ca]/10 border border-[#7928ca]/30 px-3 py-1 rounded-full">
        EVENT CALENDAR
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight heading-section">
        4-Week Event Schedule.
      </h2>
      <p class="text-gray-400 max-w-xl mx-auto text-base">
        A structured month of activities so you never miss out on movie nights, customs, or giveaways.
      </p>
    </div>

    <!-- Timeline Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {weeks.map((item) => (
        <div class="glass-card rounded-2xl p-6 border border-white/10 flex flex-col justify-between group hover:border-[#5865F2]/40 transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono-code font-bold text-[#5865F2]">{item.week}</span>
              <span class={`text-[10px] font-mono-code px-2.5 py-0.5 rounded-full border ${item.statusColor}`}>
                {item.status}
              </span>
            </div>

            <span class="text-[11px] font-mono-code text-gray-400 block mb-1">{item.dates}</span>
            <h3 class="text-lg font-bold text-white mb-3 group-hover:text-[#5865F2] transition-colors">
              {item.title}
            </h3>

            <p class="text-xs text-gray-400 leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-white/10 space-y-2">
            <span class="text-[10px] font-mono-code text-gray-400 uppercase tracking-wider block mb-2">Activities:</span>
            {item.events.map((evt) => (
              <div class="flex items-center gap-2 text-xs text-gray-300">
                <svg class="w-3.5 h-3.5 text-[#50e3c2] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>{evt}</span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
