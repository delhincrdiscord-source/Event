---
const venues = [
  {
    name: "CyberHub Esports Arena",
    city: "Gurugram, Haryana",
    role: "PC Esports & Grand Finals Mainstage",
    specs: "240Hz ZOWIE Setups • 2,500 Capacity • Live Broadcast Desk",
    address: "DLF Cyber City, Phase 2, Gurugram, Haryana 122002",
    badge: "MAIN LAN VENUE"
  },
  {
    name: "Pragati Maidan Expo Hall 5",
    city: "New Delhi",
    role: "Cosplay Runway & Creator Convention",
    specs: "Cosplay Mainstage • Creator Lounges • Sponsor Experience Zone",
    address: "Pragati Maidan, Mathura Road, New Delhi 110001",
    badge: "EXPO & COSPLAY"
  },
  {
    name: "Noida Stadium Complex",
    city: "Noida, Uttar Pradesh",
    role: "Mobile Esports & Console Arena",
    specs: "PS5 Fighting Stage • 512-Roster BGMI Arena • Food Trucks",
    address: "Sector 21A, Noida, Uttar Pradesh 201301",
    badge: "CONSOLE & MOBILE"
  }
];
---

<section id="venues" class="py-24 bg-[#07070a] border-b border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="text-center mb-16 space-y-3">
      <span class="text-xs font-mono-code text-[#00dfd8] uppercase tracking-widest bg-[#00dfd8]/10 border border-[#00dfd8]/30 px-3 py-1 rounded-full">
        OFFLINE LAN LOCATIONS
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight heading-section">
        Delhi NCR Venue Network.
      </h2>
      <p class="text-gray-400 max-w-xl mx-auto text-base">
        Three strategic hubs across the capital region hosting the live weekend LAN events.
      </p>
    </div>

    <!-- Venue Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {venues.map((venue) => (
        <div class="aurora-card rounded-2xl p-6 border border-white/10 relative flex flex-col justify-between group hover:border-[#00dfd8]/50 transition-all">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono-code font-bold px-2.5 py-0.5 rounded-full bg-[#00dfd8]/10 text-[#00dfd8] border border-[#00dfd8]/30">
                {venue.badge}
              </span>
              <span class="text-xs font-mono-code text-gray-400">{venue.city}</span>
            </div>

            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-[#50e3c2] transition-colors">
              {venue.name}
            </h3>
            <p class="text-xs font-semibold text-gray-300 mb-3">
              {venue.role}
            </p>

            <div class="bg-white/[0.03] border border-white/10 rounded-xl p-3 mb-4 text-xs font-mono-code text-gray-400">
              {venue.specs}
            </div>
          </div>

          <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono-code text-gray-400">
            <span class="truncate max-w-[200px]">{venue.address}</span>
            <a 
              href={`https://maps.google.com/?q=${encodeURIComponent(venue.address)}`} 
              target="_blank" 
              class="text-[#50e3c2] hover:underline shrink-0 ml-2 font-semibold"
            >
              Get Directions →
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
