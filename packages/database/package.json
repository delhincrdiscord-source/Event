{
  "name": "@gameverse/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "pnpm db:generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@gameverse/types": "workspace:*",
    "@prisma/client": "^6.8.0"
  },
  "devDependencies": {
    "@gameverse/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "better-auth": "^1.0.0",
    "prisma": "^6.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  }
}
