// =====================================================
// Delhi NCR Gameverse 2026 — Prisma Schema
// =====================================================
// Production-ready database schema for 100K+ users
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Enums
// =====================================================

enum RoleName {
  ADMIN
  ORGANIZER
  MODERATOR
  MEMBER
  GUEST
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  MEMBERS_ONLY
  HIDDEN
}

enum PassStatus {
  ACTIVE
  CHECKED_IN
  REVOKED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
  CHECKED_IN
  COMPLETED
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  NUMBER
  PHONE
  DISCORD_USERNAME
  DISCORD_USER_ID
  GAME_UID
  IGN
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  DATE
  TIME
  COUNTRY
  FILE_UPLOAD
  URL
  SECTION_HEADER
  DIVIDER
  PARAGRAPH
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  SYSTEM
  ANNOUNCEMENT
  REGISTRATION
  APPROVAL
  REMINDER
  FESTIVAL
  EVENT
  CUSTOM
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementVisibility {
  PUBLIC
  MEMBERS_ONLY
  ADMINS_ONLY
}

enum NotificationChannel {
  IN_APP
  DISCORD
  EMAIL
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum WebhookStatus {
  SUCCESS
  FAILED
  RETRYING
}

// =====================================================
// Module 1: Users & RBAC
// =====================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  passwordHash  String?   @map("password_hash") @db.Text
  username      String    @unique @db.VarChar(64)
  globalName    String?   @map("global_name") @db.VarChar(128)
  avatarUrl     String?   @map("avatar_url") @db.Text
  bio           String?   @db.Text
  timezone      String?   @default("Asia/Kolkata") @db.VarChar(64)
  socialLinks   Json?     @map("social_links")
  notificationPrefs Json @default("{\"email\":true,\"push\":true,\"discord\":true}") @map("notification_prefs")
  privacySettings Json   @default("{\"show_profile\":true,\"show_email\":false}") @map("privacy_settings")
  isVerified    Boolean   @default(false) @map("is_verified")
  bannedAt      DateTime? @map("banned_at")
  banReason     String?   @map("ban_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  discordAccount    DiscordAccount?
  sessions          Session[]
  accounts          Account[]
  verificationTokens VerificationToken[]
  userRoles         UserRole[]
  registrations     Registration[]
  registrationNotes RegistrationNote[]
  eventRsvps        EventRsvp[]
  announcements     Announcement[]
  galleryItems      GalleryItem[]
  approvedGalleryItems GalleryItem[] @relation("ApprovedGallery")
  media             Media[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  discordMemberSyncs DiscordMemberSync[]
  userPoints          UserPoints[]
  userAchievements    UserAchievement[]
  userBadges          UserBadge[]
  userRewards         UserReward[]

  @@index([deletedAt], name: "idx_users_email_active")
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(64)
  description String? @db.Text

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =====================================================
// Module 2: Festivals & Event Core
// =====================================================

enum FestivalStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  ARCHIVED
}

enum FestivalVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Festival {
  id                     String             @id @default(uuid()) @db.Uuid
  name                   String             @db.VarChar(128)
  slug                   String             @unique @db.VarChar(64)
  shortDescription       String?            @map("short_description") @db.VarChar(256)
  fullDescription        String?            @map("full_description") @db.Text
  bannerUrl              String?            @map("banner_url") @db.Text
  logoUrl                String?            @map("logo_url") @db.Text
  themeColor             String             @default("#5865F2") @map("theme_color") @db.VarChar(7)
  discordInvite          String?            @map("discord_invite") @db.Text
  registrationEnabled    Boolean            @default(false) @map("registration_enabled")
  registrationStart      DateTime?          @map("registration_start")
  registrationEnd        DateTime?          @map("registration_end")
  startDate              DateTime           @map("start_date")
  endDate                DateTime           @map("end_date")
  timezone               String             @default("Asia/Kolkata") @db.VarChar(64)
  visibility             FestivalVisibility @default(PUBLIC)
  status                 FestivalStatus     @default(DRAFT)
  isActive               Boolean            @default(true) @map("is_active")
  isDeleted              Boolean            @default(false) @map("is_deleted")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  createdBy              String?            @map("created_by") @db.Uuid

  // Relations
  events         CommunityEvent[]
  registrations  Registration[]
  formFields     FormField[]
  announcements  Announcement[]

  @@index([status], name: "idx_festivals_status")
  @@index([isDeleted], name: "idx_festivals_active")
  @@index([startDate], name: "idx_festivals_start_date")
  @@map("festivals")
}

model EventCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(64)
  slug        String   @unique @db.VarChar(64)
  emoji       String?  @db.VarChar(16)
  icon        String?  @db.VarChar(64)
  description String?  @db.Text
  color       String   @default("#5865F2") @db.VarChar(7)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  events CommunityEvent[]

  @@index([isDeleted], name: "idx_categories_active")
  @@index([sortOrder], name: "idx_categories_sort")
  @@map("event_categories")
}

model CommunityEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  festivalId            String          @map("festival_id") @db.Uuid
  categoryId            String          @map("category_id") @db.Uuid
  title                 String          @db.VarChar(128)
  slug                  String          @unique @db.VarChar(128)
  shortDescription      String?         @map("short_description") @db.VarChar(256)
  fullDescription       String?         @map("full_description") @db.Text
  bannerUrl             String?         @map("banner_url") @db.Text
  thumbnailUrl          String?         @map("thumbnail_url") @db.Text
  startDate             DateTime        @map("start_date")
  endDate               DateTime        @map("end_date")
  timezone              String          @default("Asia/Kolkata") @db.VarChar(64)
  location              String?         @db.VarChar(128)
  discordVoiceChannelId String?         @map("discord_voice_channel_id") @db.VarChar(64)
  discordStageChannelId String?         @map("discord_stage_channel_id") @db.VarChar(64)
  capacity              Int?
  waitlistEnabled       Boolean         @default(false) @map("waitlist_enabled")
  registrationEnabled   Boolean         @default(false) @map("registration_enabled")
  registrationStart     DateTime?       @map("registration_start")
  registrationEnd       DateTime?       @map("registration_end")
  status                EventStatus     @default(DRAFT)
  visibility            EventVisibility @default(PUBLIC)
  isFeatured            Boolean         @default(false) @map("is_featured")
  isDeleted             Boolean         @default(false) @map("is_deleted")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  createdBy             String?         @map("created_by") @db.Uuid

  // Relations
  festival Festival      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  category EventCategory @relation(fields: [categoryId], references: [id])
  rsvps    EventRsvp[]
  formFields  FormField[]
  formVersions FormVersion[]
  formResponses FormResponse[]
  registrations Registration[]

  @@index([festivalId, categoryId], name: "idx_events_festival_category")
  @@index([startDate], name: "idx_events_start_date")
  @@index([status], name: "idx_events_status")
  @@index([isDeleted], name: "idx_events_active")
  @@index([discordVoiceChannelId, startDate, endDate], name: "idx_events_conflict_check")
  @@map("community_events")
}

// =====================================================
// Module 3: Registration & Form Builder
// =====================================================

model Registration {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  festivalId      String             @map("festival_id") @db.Uuid
  eventId         String?            @map("event_id") @db.Uuid
  formVersionId   String?            @map("form_version_id") @db.Uuid
  passNumber      String             @unique @map("pass_number") @db.VarChar(32)
  status          RegistrationStatus @default(PENDING)
  notes           String?            @db.Text
  qrCode         String?            @unique @map("qr_code") @db.VarChar(128)
  fullName        String             @map("full_name") @db.VarChar(128)
  email           String             @db.VarChar(255)
  interest        String             @map("interest") @db.VarChar(128)
  discordUsername  String?            @map("discord_username") @db.VarChar(128)
  discordMessageId String?           @map("discord_message_id") @db.VarChar(64)
  discordChannelId String?           @map("discord_channel_id") @db.VarChar(64)
  checkedInAt     DateTime?          @map("checked_in_at")
  checkedInBy     String?            @map("checked_in_by") @db.Uuid
  approvedAt      DateTime?          @map("approved_at")
  approvedBy      String?            @map("approved_by") @db.Uuid
  rejectedAt      DateTime?          @map("rejected_at")
  rejectedBy      String?            @map("rejected_by") @db.Uuid
  cancelReason    String?            @map("cancel_reason") @db.Text
  registeredAt    DateTime           @default(now()) @map("registered_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  isDeleted       Boolean            @default(false) @map("is_deleted")

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  festival     Festival          @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  event        CommunityEvent?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formVersion  FormVersion?      @relation(fields: [formVersionId], references: [id])
  responses    FormResponse[]
  notesList    RegistrationNote[]
  timeline     RegistrationTimeline[]

  @@unique([userId, eventId])
  @@index([status], name: "idx_registrations_status")
  @@index([eventId], name: "idx_registrations_event")
  @@index([festivalId], name: "idx_registrations_festival")
  @@index([userId], name: "idx_registrations_user")
  @@index([qrCode], name: "idx_registrations_qr")
  @@map("registrations")
}

model RegistrationNote {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  content        String   @db.Text
  isInternal     Boolean  @default(true) @map("is_internal")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([registrationId], name: "idx_registration_notes_reg")
  @@map("registration_notes")
}

model RegistrationTimeline {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  action         String   @db.VarChar(64)
  actorId        String?  @map("actor_id") @db.Uuid
  actorName      String?  @map("actor_name") @db.VarChar(128)
  details        Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId], name: "idx_registration_timeline_reg")
  @@index([createdAt], name: "idx_registration_timeline_date")
  @@map("registration_timeline")
}

model FormField {
  id                String        @id @default(uuid()) @db.Uuid
  festivalId        String?       @map("festival_id") @db.Uuid
  eventId           String?       @map("event_id") @db.Uuid
  fieldName         String        @map("field_name") @db.VarChar(64)
  label             String        @db.VarChar(128)
  fieldType         FormFieldType @map("field_type")
  description       String?       @db.Text
  placeholder       String?       @db.VarChar(128)
  isRequired        Boolean       @default(false) @map("is_required")
  minLength         Int?          @map("min_length")
  maxLength         Int?          @map("max_length")
  pattern           String?       @db.VarChar(256)
  defaultValue      String?       @map("default_value") @db.Text
  helpText          String?       @map("help_text") @db.Text
  validationMessage String?       @map("validation_message") @db.VarChar(256)
  displayOrder      Int           @default(0) @map("display_order")
  options           Json?
  isActive          Boolean       @default(true) @map("is_active")
  isDeleted         Boolean       @default(false) @map("is_deleted")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  festival  Festival?      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  event     CommunityEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses FormResponse[]

  @@index([festivalId], name: "idx_form_fields_festival")
  @@index([eventId], name: "idx_form_fields_event")
  @@index([displayOrder], name: "idx_form_fields_order")
  @@map("form_fields")
}

model FormVersion {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  version     Int        @default(1)
  status      FormStatus @default(DRAFT)
  fieldsJson  Json       @map("fields_json")
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  event        CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, version])
  @@index([eventId], name: "idx_form_versions_event")
  @@map("form_versions")
}

model FormResponse {
  id            String   @id @default(uuid()) @db.Uuid
  registrationId String? @map("registration_id") @db.Uuid
  eventId       String?  @map("event_id") @db.Uuid
  formFieldId   String   @map("form_field_id") @db.Uuid
  responseValue String   @map("response_value") @db.Text
  version       Int      @default(1)
  submittedAt   DateTime @default(now()) @map("submitted_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        CommunityEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formField    FormField     @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@index([eventId], name: "idx_form_responses_event")
  @@index([formFieldId], name: "idx_form_responses_field")
  @@index([registrationId], name: "idx_form_responses_registration")
  @@map("form_responses")
}

// =====================================================
// Module 4: Discord Integration & Logs
// =====================================================

enum DiscordAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum AutomationTrigger {
  REGISTRATION_APPROVED
  ANNOUNCEMENT_PUBLISHED
  EVENT_PUBLISHED
  EVENT_REMINDER
  EVENT_COMPLETED
  USER_JOINED
  USER_LEFT
}

enum AutomationAction {
  ASSIGN_ROLE
  REMOVE_ROLE
  SEND_EMBED
  SEND_MESSAGE
  SEND_NOTIFICATION
}

enum LogEventType {
  GUILD_EVENT
  ROLE_CHANGE
  WEBHOOK_EVENT
  SLASH_COMMAND
  BOT_EVENT
  ERROR
}

enum BotStatus {
  ONLINE
  OFFLINE
  ERROR
  STARTING
  STOPPING
}

model DiscordConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  botTokenEncrypted     String   @map("bot_token_encrypted") @db.Text
  guildId               String   @map("guild_id") @db.VarChar(64)
  clientId              String   @map("client_id") @db.VarChar(64)
  clientSecretEncrypted String?  @map("client_secret_encrypted") @db.Text
  publicKey             String?  @map("public_key") @db.VarChar(128)
  botStatus             BotStatus @default(OFFLINE) @map("bot_status")
  lastLatency           Int?     @map("last_latency")
  lastCheckedAt         DateTime? @map("last_checked_at")
  isVerified            Boolean  @default(false) @map("is_verified")
  registeredRoleId      String?  @map("registered_role_id") @db.VarChar(64)
  registrationsChannelId String? @map("registrations_channel_id") @db.VarChar(64)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  guilds           DiscordGuild[]
  roles            DiscordRole[]
  channels         DiscordChannel[]
  webhooks         DiscordWebhook[]
  automations      DiscordAutomation[]
  slashCommands    DiscordSlashCommand[]
  activityLogs     DiscordActivityLog[]
  roleMappings     DiscordRoleMapping[]
  memberSyncs      DiscordMemberSync[]

  @@map("discord_configs")
}

model DiscordGuild {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.Uuid
  guildId          String   @map("guild_id") @db.VarChar(64)
  name             String   @db.VarChar(128)
  iconUrl          String?  @map("icon_url") @db.Text
  memberCount      Int      @default(0) @map("member_count")
  onlineCount      Int      @default(0) @map("online_count")
  boostCount       Int      @default(0) @map("boost_count")
  boostLevel       Int      @default(0) @map("boost_level")
  ownerId          String?  @map("owner_id") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  config DiscordConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, guildId])
  @@index([configId], name: "idx_discord_guilds_config")
  @@map("discord_guilds")
}

model DiscordRole {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.Uuid
  roleId           String   @map("role_id") @db.VarChar(64)
  name             String   @db.VarChar(128)
  color            Int      @default(0)
  position         Int      @default(0)
  isManaged        Boolean  @default(false) @map("is_managed")
  mentionable      Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  config   DiscordConfig       @relation(fields: [configId], references: [id], onDelete: Cascade)
  mappings DiscordRoleMapping[]

  @@unique([configId, roleId])
  @@index([configId], name: "idx_discord_roles_config")
  @@map("discord_roles")
}

model DiscordChannel {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.Uuid
  channelId        String   @map("channel_id") @db.VarChar(64)
  name             String   @db.VarChar(128)
  type             Int      @default(0)
  topic            String?  @db.Text
  nsfw             Boolean  @default(false)
  position         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  config   DiscordConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  webhooks DiscordWebhook[]

  @@unique([configId, channelId])
  @@index([configId], name: "idx_discord_channels_config")
  @@map("discord_channels")
}

model DiscordWebhook {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.Uuid
  channelId        String   @map("channel_id") @db.Uuid
  webhookId        String   @unique @map("webhook_id") @db.VarChar(64)
  name             String   @db.VarChar(128)
  avatarUrl        String?  @map("avatar_url") @db.Text
  token            String   @db.VarChar(256)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  config  DiscordConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  channel DiscordChannel @relation(fields: [channelId], references: [id])
  logs    DiscordWebhookLog[]

  @@index([configId], name: "idx_discord_webhooks_config")
  @@index([channelId], name: "idx_discord_webhooks_channel")
  @@map("discord_webhooks")
}

model DiscordRoleMapping {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  platformRole     String   @map("platform_role") @db.VarChar(64)
  autoAssign       Boolean  @default(false) @map("auto_assign")
  autoRemove       Boolean  @default(false) @map("auto_remove")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  config DiscordConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  role   DiscordRole   @relation(fields: [roleId], references: [id])

  @@unique([configId, roleId, platformRole])
  @@index([configId], name: "idx_discord_role_mappings_config")
  @@map("discord_role_mappings")
}

model DiscordAutomation {
  id               String           @id @default(uuid()) @db.Uuid
  configId         String           @map("config_id") @db.Uuid
  name             String           @db.VarChar(128)
  description      String?          @db.Text
  trigger          AutomationTrigger
  action           AutomationAction
  channelId        String?          @map("channel_id") @db.VarChar(64)
  roleId           String?          @map("role_id") @db.VarChar(64)
  messageTemplate  String?          @map("message_template") @db.Text
  embedJson        Json?            @map("embed_json")
  conditions       Json?
  isActive         Boolean          @default(true) @map("is_active")
  lastTriggeredAt  DateTime?        @map("last_triggered_at")
  triggerCount     Int              @default(0) @map("trigger_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  config DiscordConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId], name: "idx_discord_automations_config")
  @@index([trigger], name: "idx_discord_automations_trigger")
  @@map("discord_automations")
}

model DiscordSlashCommand {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.Uuid
  commandId        String?  @map("command_id") @db.VarChar(64)
  name             String   @db.VarChar(32)
  description      String   @db.VarChar(100)
  options          Json?
  isGlobal         Boolean  @default(true) @map("is_global")
  isEnabled        Boolean  @default(true) @map("is_enabled")
  usageCount       Int      @default(0) @map("usage_count")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  config DiscordConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, name])
  @@index([configId], name: "idx_discord_slash_commands_config")
  @@map("discord_slash_commands")
}

model DiscordWebhookLog {
  id               String        @id @default(uuid()) @db.Uuid
  webhookId        String        @map("webhook_id") @db.Uuid
  eventType        String        @map("event_type") @db.VarChar(64)
  status           WebhookStatus
  payloadJson      Json          @map("payload_json")
  responseJson     Json?         @map("response_json")
  statusCode       Int?          @map("status_code")
  errorMessage     String?       @map("error_message") @db.Text
  executedAt       DateTime      @default(now()) @map("executed_at")
  durationMs       Int?          @map("duration_ms")

  // Relations
  webhook DiscordWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId], name: "idx_discord_webhook_logs_webhook")
  @@index([status], name: "idx_discord_webhook_logs_status")
  @@index([executedAt], name: "idx_discord_webhook_logs_date")
  @@map("discord_webhook_logs")
}

model DiscordMemberSync {
  id               String   @id @default(uuid()) @db.Uuid
  configId         String   @map("config_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  discordUserId    String   @map("discord_user_id") @db.VarChar(64)
  discordUsername   String?  @map("discord_username") @db.VarChar(128)
  discordNickname  String?  @map("discord_nickname") @db.VarChar(128)
  discordAvatarUrl String?  @map("discord_avatar_url") @db.Text
  isMember         Boolean  @default(true) @map("is_member")
  lastSyncedAt     DateTime @default(now()) @map("last_synced_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  config DiscordConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([configId, userId])
  @@unique([configId, discordUserId])
  @@index([configId], name: "idx_discord_member_syncs_config")
  @@index([userId], name: "idx_discord_member_syncs_user")
  @@map("discord_member_syncs")
}

model DiscordActivityLog {
  id               String        @id @default(uuid()) @db.Uuid
  configId         String        @map("config_id") @db.Uuid
  eventType        LogEventType  @map("event_type")
  action           String        @db.VarChar(128)
  actorId          String?       @map("actor_id") @db.VarChar(64)
  actorName        String?       @map("actor_name") @db.VarChar(128)
  targetId         String?       @map("target_id") @db.VarChar(64)
  targetName       String?       @map("target_name") @db.VarChar(128)
  details          Json?
  metadata         Json?
  ipAddress        String?       @map("ip_address") @db.VarChar(45)
  createdAt        DateTime      @default(now()) @map("created_at")

  // Relations
  config DiscordConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId], name: "idx_discord_activity_logs_config")
  @@index([eventType], name: "idx_discord_activity_logs_type")
  @@index([createdAt], name: "idx_discord_activity_logs_date")
  @@map("discord_activity_logs")
}

model DiscordAccount {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  discordUserId      String    @unique @map("discord_user_id") @db.VarChar(64)
  username           String    @db.VarChar(128)
  discriminator      String?   @db.VarChar(4)
  globalName         String?   @map("global_name") @db.VarChar(128)
  avatarUrl          String?   @map("avatar_url") @db.Text
  accessTokenEncrypted String @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String @map("refresh_token_encrypted") @db.Text
  expiresAt          DateTime  @map("expires_at")
  scope              String?   @db.Text
  joinedDiscordAt    DateTime? @map("joined_discord_at")
  isGuildMember      Boolean   @default(false) @map("is_guild_member")
  guildJoinedAt      DateTime? @map("guild_joined_at")
  nickname           String?   @db.VarChar(128)
  syncedAt           DateTime  @default(now()) @map("synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discordUserId], name: "idx_discord_accounts_discord_user")
  @@map("discord_accounts")
}

// =====================================================
// Module 5: Announcements, FAQ, Gallery, Media & Settings
// =====================================================

model Announcement {
  id             String                  @id @default(uuid()) @db.Uuid
  title          String                  @db.VarChar(256)
  slug           String                  @unique @db.VarChar(256)
  summary        String?                 @db.VarChar(512)
  content        String                  @db.Text
  bannerUrl      String?                 @map("banner_url") @db.Text
  authorId       String                  @map("author_id") @db.Uuid
  festivalId     String?                 @map("festival_id") @db.Uuid
  priority       AnnouncementPriority    @default(NORMAL)
  visibility     AnnouncementVisibility  @default(PUBLIC)
  status         AnnouncementStatus      @default(DRAFT)
  publishAt      DateTime?               @map("publish_at")
  expireAt       DateTime?               @map("expire_at")
  tags           String[]                @default([])
  viewCount      Int                     @default(0) @map("view_count")
  isPinned       Boolean                 @default(false) @map("is_pinned")
  isDeleted      Boolean                 @default(false) @map("is_deleted")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  // Relations
  author   User              @relation(fields: [authorId], references: [id])
  festival Festival?         @relation(fields: [festivalId], references: [id])
  deliveries NotificationDelivery[]

  @@index([status], name: "idx_announcements_status")
  @@index([publishAt], name: "idx_announcements_publish")
  @@index([authorId], name: "idx_announcements_author")
  @@index([festivalId], name: "idx_announcements_festival")
  @@index([isDeleted], name: "idx_announcements_active")
  @@map("announcements")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(256)
  message    String           @db.Text
  link       String?          @db.VarChar(512)
  metadata   Json?
  isRead     Boolean          @default(false) @map("is_read")
  isArchived Boolean          @default(false) @map("is_archived")
  createdAt  DateTime         @default(now()) @map("created_at")
  readAt     DateTime?        @map("read_at")

  // Relations
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId], name: "idx_notifications_user")
  @@index([userId, isRead], name: "idx_notifications_user_read")
  @@index([userId, isArchived], name: "idx_notifications_user_archived")
  @@index([createdAt], name: "idx_notifications_created")
  @@map("notifications")
}

model NotificationDelivery {
  id             String           @id @default(uuid()) @db.Uuid
  notificationId String           @map("notification_id") @db.Uuid
  announcementId String?          @map("announcement_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus   @default(PENDING)
  sentAt         DateTime?        @map("sent_at")
  failedAt       DateTime?        @map("failed_at")
  errorMessage   String?          @map("error_message") @db.Text
  retryCount     Int              @default(0) @map("retry_count")
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  // Relations
  notification Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id])

  @@index([notificationId], name: "idx_notification_deliveries_notification")
  @@index([announcementId], name: "idx_notification_deliveries_announcement")
  @@index([status], name: "idx_notification_deliveries_status")
  @@index([channel], name: "idx_notification_deliveries_channel")
  @@map("notification_deliveries")
}

model Media {
  id        String   @id @default(uuid()) @db.Uuid
  fileKey   String   @unique @map("file_key") @db.VarChar(255)
  url       String   @db.Text
  mimeType  String   @map("mime_type") @db.VarChar(64)
  sizeBytes BigInt   @map("size_bytes")
  uploaderId String? @map("uploader_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  uploader    User?        @relation(fields: [uploaderId], references: [id])
  galleryItem GalleryItem?

  @@map("media")
}

model GalleryItem {
  id           String    @id @default(uuid()) @db.Uuid
  mediaId      String    @unique @map("media_id") @db.Uuid
  title        String    @db.VarChar(128)
  authorId     String    @map("author_id") @db.Uuid
  isApproved   Boolean   @default(false) @map("is_approved")
  approvedById String?   @map("approved_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  media      Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  author     User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("ApprovedGallery", fields: [approvedById], references: [id])

  @@map("gallery_items")
}

model FAQ {
  id           String   @id @default(uuid()) @db.Uuid
  question     String   @db.Text
  answer       String   @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")

  @@map("faqs")
}

model Setting {
  key         String   @id @db.VarChar(64)
  valueJson   Json     @map("value_json")
  description String?  @db.Text
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(128)
  targetEntity String   @map("target_entity") @db.VarChar(64)
  targetId     String?  @map("target_id") @db.VarChar(64)
  changesJson  Json?    @map("changes_json")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  timestamp    DateTime @default(now())

  // Relations
  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId], name: "idx_audit_logs_actor")
  @@index([action], name: "idx_audit_logs_action")
  @@index([targetEntity, targetId], name: "idx_audit_logs_target")
  @@index([timestamp], name: "idx_audit_logs_timestamp")
  @@map("audit_logs")
}

// =====================================================
// Auth Tables (Better Auth)
// =====================================================

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token], name: "idx_sessions_token")
  @@index([userId], name: "idx_sessions_user")
  @@index([expiresAt], name: "idx_sessions_expires")
  @@map("sessions")
}

model Account {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String    @db.VarChar(32)
  providerAccountId String    @map("provider_account_id") @db.VarChar(255)
  accessToken       String?   @db.Text
  refreshToken      String?   @db.Text
  tokenExpiresAt    DateTime? @map("token_expires_at")
  scope             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @db.VarChar(255)
  type      String   @db.VarChar(32)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model RateLimitAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(255)
  count       Int      @default(1)
  windowStart DateTime @default(now()) @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@map("rate_limit_attempts")
}

// =====================================================
// Event RSVPs (Junction Table)
// =====================================================

model EventRsvp {
  eventId    String   @db.Uuid
  userId     String   @db.Uuid
  rsvpedAt   DateTime @default(now()) @map("rsvped_at")

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_rsvps")
}

// =====================================================
// Gamification System
// =====================================================

model UserPoints {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  points    Int      @default(0)
  source    String   @db.VarChar(64)
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_user_points_user")
  @@index([createdAt], name: "idx_user_points_date")
  @@map("user_points")
}

model Achievement {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(128)
  description String? @db.Text
  icon        String  @db.VarChar(32)
  category    String  @db.VarChar(64)
  pointValue  Int     @default(0) @map("point_value")
  criteria    Json?
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId], name: "idx_user_achievements_user")
  @@map("user_achievements")
}

model Badge {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(128)
  description String? @db.Text
  icon        String  @db.VarChar(32)
  tier        String  @db.VarChar(32)
  pointValue  Int     @default(0) @map("point_value")
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  earnedAt  DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId], name: "idx_user_badges_user")
  @@map("user_badges")
}

model Reward {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(128)
  description String?  @db.Text
  icon        String   @db.VarChar(32)
  pointCost   Int      @default(0) @map("point_cost")
  stock       Int      @default(-1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  userRewards UserReward[]

  @@map("rewards")
}

model UserReward {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rewardId  String   @map("reward_id") @db.Uuid
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_user_rewards_user")
  @@map("user_rewards")
}
